  {
   "seq": "7",
   "text": "風尚けはさきそめし春も遠からぬ梅や千里に匂ひ行らん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "若木梅",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "水草ゐるふる江の柳くちぬともゆる緑のかけやなからん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "江柳",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "春は又おち葉かきても松かせの磯なつむ成りあまのをめ子",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "磯春草",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "二葉ともくつの御牧の春の草もゆれはやかて物そすさむる",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "牧春助",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "はしたての松もかくとや浪の上にかすみてなしぬ春のかりかね",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海帰雁",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "春はまた立かふ山領の雪かけて花まちとをへさゆる白雲",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "待花",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "あすかつ花のかふれてゆく袖の匂のふちよせにおかはりそ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "交花",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "手をりつゝかさす桜の花のかのこつるは老の袖もいとはす",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花柳頭",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "一それをこそとふにはなさめ桜花ちりなん後の春の山ふみ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家老",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "嵐吹花はちりかひくもる夜をよそにやかすむ春の夜の月",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落花",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "〽おなしえに子を思ふ難からふれて鳴やつへの音つのもろ声",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "沢春雉",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "すきかてにたれとはさらん山吹の花のかさりの玉河の里",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "款冬盛",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "一住かしの松の葉うつむ藤の花岸にかふてふ草にやつかに",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "岸藤",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "一名体をもしはしとゝめし花鳥の入にし雲をさよふ春かな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮春雲",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "猶もおし花のかのこる朝露春ぬれてひぬさもかふる衣は",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "朝更衣",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "さく藤も夏にかゝるをしるへにて又たつねつる山さくらかな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "尋余花",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "これや此あなうの花とおもへとも立かへりくるしたしまの道",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "路卯花",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "つれなさは暁はかりうき物とおもひもわてぬほとゝきす哉",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁郭公",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "雨かゝる山野は消て時鳥なくやゆふへにまよふうき雲",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕郭公",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "ほとゝきすのいつくの月とたてしかぬやそのあくる一声",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜郭公",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "〽なかき日の千町のさなへうへつかれ山田のくろにやすむさ乙女",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早苗",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "一吹風に花たち花もあへぬとや軒のしのふにみたれならん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "薩盧橘",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "浮雲は猶もたかねをうつむなりはれてもはれぬ五月雨の空",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "松ほつかなそこらの事をみし夢のさむる枕は夏の夜るして",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏夜",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "夏のよの月にこほるゝ声すこし秋風またぬ萩の下露",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏月涼",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "うけすみて行や何れのなひきもゝしける生田のもりの下草",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杜夏草",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "一橋姫の寒しの玉と河浪に蛍みたるゝうちの山かせ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "橋蛍",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "水かさます都のよもの夕立に先しら川の浪そきこゆる",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河夕立",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "おもふことさしてなき身や夏をそふすつるはかりのあせのゆふして",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "六月祓",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "いつしかに昨日の夏を風かは日衣も秋もへたてゝそおもふ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首初秋衣",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "七夕の妻たつけふの夕雪にいふせさそふるあま河霧",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七夕霧",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "幾世まてふるゆゝ小篠かゝらまし都のおくの秋の夕つゆ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古郷露",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "一あとそなき風まつ程の萩のはゝやとかし夢も露のまにして",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩破夢",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "玉ほこの行手の小萩折とらはのこれる夢の色やあせなん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "行始夜",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "風かよふ薄いかりの草の原手ことになにをきねきこむらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "原薄",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "藤はかまぬしなきのへに匂ふをは風もあはれと多をやよからん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "蘭薫風",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "秋なからおち葉も知らぬ松虫の声うつもるゝ野へのはつてあ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野虫",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "玉つけをつとはなしの初かりやまた遠かたの秋のをとつれ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遠初雁",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "秋ふくる小野ゝ山田にさをしかの儀色こきいねそのこれる",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田鹿",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "たちいつるたかねの月の秋風におひく光りを千里にせしる",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "嶺上同",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "神かきにちかき林の松の葉の茎にましはか月もすやけし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松間月",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "浪に出る月はいとこの山よりもくたけておつる布門のまた",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "滝辺月",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "あらはなる不破の関屋の板日さしあれしも今は夢なりけり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関屋月",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "露はらふ庭のよもきか杞人の袖とや我も月もとふらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭月",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "一時しもあれ稍うつろふ月影にね覚てきくの衣うつ声",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "聞持衣",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "一老とくの床も枕も秋の夜のおかきをしるは涙なりけり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋衣長",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "さく葛のか気うく谷の下水に光りなしともみえぬ秋かな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "谷葛",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "たつた山ちらぬ紅葉に木かくれてゆふ付鳥の巻そしらなる",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "くれぬとて野にも山にも行秋に残りて露のあすやこほらん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮秋露",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "一庭草に秋よりを起し宿の霜人めかれそふ冬はきにけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初冬",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "つゝみあへぬ多か衣手の杜のはの時雨とゝもにしくれ行らん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杜付雨",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "みし色のかはるとかはる冬の春を一葉もとめぬ山の木からし",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山木枯",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "冬かれのみ山の霜をかしれたる小塵の色にあらし吹なり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "篠重",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "なにはにや風にかれたつあしつゝのうすき氷をくたく浪かな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "盧間水",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "久かたの月の光りのゆくかたやかきりしられぬ氷なまらん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一月",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "霞さゆるかれ葉のますせふみしたきそのゝ河原も千鳥鳴也",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "千馬",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "山おろしふもとのならの葉かしはあられをはこぬ音のはけしき",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "柏霰",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "つもれたゝ庭のをしへの跡たにもあたと思ふ名の白く宿",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭初雪",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "山人のそまたつをのゝをとたへてひゝきそかはる雪の下折",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杣香",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "松草のこなたの浪の朝なきと遠ろめくる雪のしら雲",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雪朝望",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "雪をたひ氷をねかふ炭かまの煙や雲の浪となるらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "炭竈煙",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "おりかへしみたま榊も神さひて庭火もしろし市の明ほつ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "神楽本郷へ",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "やとことの春のいとなみ数みへて又豊年のくるゝころかな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "年欲暮",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "おもふより涙の袖のしからには風のかけてや露こほるらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄風恋",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "下るへすもゆか只もはれやらてたへぬ煙や胸もくつらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄煙恋",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "天つかせ雲ふく雨のあしたつしうきて思ひをなにかさぬらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄雨真",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "いつの世の色か枕よりつもりけむ我称し床の茎出らぬ山",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄山慈",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "ことの葉もうつろひぬとや水くきの岡のくす原色かはるらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄岡慈",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "草の原むすひもはれぬ秋風をたれかしめちか露雨のむらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄原恋",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "おふよとのまつとわかれる事よせて心なくへきうら浪もなし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄松庵",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "人こゝろはたひ客をく柳もにつれなき色は猶やますらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄榊恋",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "われからと身をよせくたけ心なきあまのかる迄に乱れ院つゝ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄藻恋",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "鳴はつる座さへつらしかきて行たる名もくらぬ色の北声に",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄鳥恋",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "人はゝや斯はなからに友のむなりしはしかたゝそつかにのいと",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄虫恋",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "さをしかのなしとは露もましおらん涙はかりのひとりねの床",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄獣恋",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "かへしてもなにゝかはせんさよろさむれはつらき夢もほとなし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄衣恋",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "契りしたわてはうき名にたつか弓おかなき鳥の跡も残さし",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄弓恋",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "匁のめつゝ世々にをかけんかた糸をあはをによりし契り桜すは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄糸恋",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "嵐山ふももの寺のかね其こゑ夢やひとりさひしかりけむ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古寺鐘",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "命をもいかゝかのへん住よしの松のことも葉大とならすは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松作友",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "山のこのあくるもしらす竹の葉のか気に夜ふかき窓の燈",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "窓竹",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "松かねもいわほも苔の道殿へて落はにむけふ山の下に",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "経苔",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "わかの浦に身ハ老齢のひなのなもかくやいしらぬ道にまとはん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "名所鶴",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "浪雨かみ嵐出大かふ瀧のよにうかふ御舟の山はうこかす",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "名所瀧",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "草かくれ水のたよりにかたかけて山沢なかくむすふ庵かな",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家水",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "かよひなき田中のさとの一むとはいなはかりての後そさひしき",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田里",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "一峯たかくのほりてくたる松かけに薪おろしくやすむ山人",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "樵夫",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "川浪に松山おろしせくらすはつなてやひかん瀬々の筏士",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松川茂",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "やとるなよ月よそゆるす枕とて草引むすふ野への夕露",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅夕",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "一舟とむるむしあけのせとの浪風いかなる夢をまつの下陰",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅酒夢",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "しかのうらなきたる雲の浪まよりみゆる小嶋にいそくふな人",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖作金",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "へ反てつる十の老かひそをのつからひとつ心のうちそひらくる",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "釈教",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "千はやふか神の御国に生れあふ我行末を猶なのむなり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "神祗",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "あり原本蜷川親当の華なれはやかて親当の詠といひし成へて",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733910",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "神祗",
   "kotobagaki": ""
  }
 ],
